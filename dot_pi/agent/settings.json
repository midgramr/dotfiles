    "npm:pi-mcp-adapter",
    "npm:pi-paster",
    "npm:pi-vimmode"
  ],
  "theme": "cendre",
  "modelThinkingLevels": {
    "openrouter/z-ai/glm-5.3-flash": "low",
    "openrouter/deepseek/deepseek-v4.1-flash": "low"
  },
  "extensions": [
    "-builtin:mcp"
