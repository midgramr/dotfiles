[global]
    width = 600
    height = 200
    origin = bottom-center
    padding = 24
    horizontal_padding = 24
    frame_width = 1
    gap_size = 8
    separator_color = frame
    font = "Overpass 12"
    mouse_left_click = do_action
    mouse_right_click = context
    mouse_middle_click = close_current
    background = "#2d353b"
    foreground = "#d3c6aa"
    highlight = "#e69875"
    frame_color = "#a7c080"
    history_length = 10

[ignore-insync]
appname = inSyncTray
skip_display = true
history_ignore = yes

