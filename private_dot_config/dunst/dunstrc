[global]
    width = 600
    height = 200
    origin = top-center
    padding = 24
    horizontal_padding = 24
    frame_width = 2
    gap_size = 8
    separator_color = frame
    font = "JetbrainsMono Nerd Font Mono 12"
    mouse_left_click = do_action
    mouse_right_click = context
    mouse_middle_click = close_current
    background = "#2d353b"
    foreground = "#d3c6aa"
    highlight = "#a7c080"
    frame_color = "#56635f"
    history_length = 20
    notification_limit = 3

[ignore-insync]
appname = inSyncTray
skip_display = true
history_ignore = yes

