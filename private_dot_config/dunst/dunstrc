[global]
    width = 600
    height = 200
    origin = top-center
    padding = 24
    horizontal_padding = 24
    frame_width = 2
    gap_size = 8
    separator_color = frame
    font = "Overpass 12"
    mouse_left_click = do_action
    mouse_right_click = context
    mouse_middle_click = close_current
    background = "#2d353b"
    foreground = "#d3c6aa"
    highlight = "#a7c080"
    frame_color = "#56635f"
    history_length = 10

[ignore-insync]
appname = inSyncTray
skip_display = true
history_ignore = yes

[ignore-fwupd-update-available]
summary = "Firmware update*available*"
skip_display = true
history_ignore = yes

[ignore-fwupd-upgradable]
body = "*can be upgraded from version*"
skip_display = true
history_ignore = yes

