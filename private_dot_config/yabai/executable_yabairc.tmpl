set -o pipefail

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# Config
yabai -m config \
    layout bsp \
    top_padding 4 \
    bottom_padding 4 \
    left_padding 4 \
    right_padding 4 \
    window_gap 4 \
    window_shadow float \
    insert_feedback_color 0xffe78a4f

# Create initial spaces
{{ if eq .chezmoi.hostname "api" -}}
spaces=(
    "Browser"
    "IDE"
    "Slack"
    "Email"
    "Zoom"
    "Misc"
)
{{- else -}}
spaces=(
    "Browser"
    "Terminal"
    "Discord"
    "Misc"
)
{{- end }}

for i in "${!spaces[@]}"; do
    name="${spaces[i]}"
    space=$((i + 1))
    case "$name" in
    *)
        layout="bsp"
        ;;
    esac
    if yabai -m query --spaces | jq '.[].index' | rg -q $space; then
        yabai -m space "$space" --label "$name" --layout "$layout"
    else
        yabai -m space --create 1 --label "$name" --layout "$layout"
    fi
done
sketchybar --trigger space_change

# Rules
{{ if eq .chezmoi.hostname "api" -}}
yabai -m rule --add label="slack" app="^Slack$" space=3
yabai -m rule --add label="outlook" app="^Microsoft Outlook$" space=4
yabai -m rule --add label="zoom" app="^Zoom$" space=5
{{- else -}}
yabai -m rule --add label="discord" app="^Discord$" space=3
{{- end }}

yabai -m rule --add label="firefox" app="^Firefox$" space=1
yabai -m rule --add label="wezterm" app="^WezTerm$" space=2
yabai -m rule --add label="misc" app="^(FaceTime|Finder|System Settings|Calculator|Activity Monitor|Messages|Reminders|Riot Client)$" manage=off
yabai -m rule --add label="pip" app="^Firefox$" title="^Picture-in-Picture$" manage=off

yabai -m rule --add label="claude" app="^Claude$" scratchpad="claude"
yabai -m rule --add label="music" app="^Music$" scratchpad="music"
yabai -m rule --add label="obsidian" app="^Obsidian$" scratchpad="obsidian"

yabai -m rule --apply
yabai -m rule --remove "firefox"
yabai -m rule --remove "wezterm"

