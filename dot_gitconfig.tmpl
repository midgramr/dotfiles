[user]
	name = Kevin Zhang
	email = {{ .email | quote }}
[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
	pager = delta
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	autoSetupRemote = true
[filter-repo]
	tool = fit-filter-repo
[color]
	ui = auto
[alias]
	ac = !git add . && git commit -m
[interactive]
	diffFilter = delta --color-only
[include]
	path = ~/.config/delta/cendre.gitconfig
[delta]
    side-by-side = true
    line-numbers = true
	navigate = true
    dark = true
    file-added-label = [+]
    file-copied-label = [==]
    file-modified-label = [*]
    file-removed-label = [-]
    file-renamed-label = [->]
    hunk-header-style = omit
    inline-hint-style = syntax
    minus-non-emph-style = syntax auto
    plus-non-emph-style = syntax auto
    whitespace-error-style = "#301d1b" reverse
    blame-code-style = syntax
    merge-conflict-begin-symbol = ⌃
    merge-conflict-end-symbol = ⌄
    merge-conflict-ours-diff-header-style = "#fcba81" bold
    merge-conflict-theirs-diff-header-style = "#fcba81" bold overline
    merge-conflict-ours-diff-header-decoration-style = ""
    merge-conflict-theirs-diff-header-decoration-style = ""

[merge]
	tool = nvimdiff2
[mergetool]
	keepBackup = false
[git-util]
	managed = true

{{ if eq .chezmoi.hostname "api" "LLTUSMZ01KEHF" -}}
[include]
	path = ~/.ttd/git-util/gitconfig
{{- end -}}
